{
  "name": "matrix-puzzle",
  "version": "0.1.0",
  "private": true,
  "description": "Matrix logic puzzle generator and solver",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli/index.js",
    "generate": "node dist/src/cli/index.js generate",
    "solve": "node dist/src/cli/index.js solve",
    "test": "node --test dist/test/**/*.js"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3"
  }
}
